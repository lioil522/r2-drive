{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "r2-drive",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DRIVE_ID": "personal",
    "APP_NAME": "R2 Drive"
  },
  "secrets": { "required": ["ADMIN_PASSWORD", "ENCRYPTION_KEY"] },
  "durable_objects": {
    "bindings": [
      { "name": "CATALOG", "class_name": "DriveCatalog" },
      { "name": "JOBS", "class_name": "BackgroundJob" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DriveCatalog", "BackgroundJob"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "r2-drive-staging",
      "vars": { "DRIVE_ID": "staging", "APP_NAME": "R2 Drive · Staging" },
      "secrets": { "required": ["ADMIN_PASSWORD", "ENCRYPTION_KEY"] },
      "durable_objects": {
        "bindings": [
          { "name": "CATALOG", "class_name": "DriveCatalog" },
          { "name": "JOBS", "class_name": "BackgroundJob" }
        ]
      }
    }
  }
}
